<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="200.0" prefWidth="400.0" style="-fx-background-color: linear-gradient(to bottom, #f7f1e3, #e8dcc8);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg123022.Controller.admin.AdminController">

    <center>
        <VBox alignment="CENTER" spacing="8.0">
            <padding>
                <Insets bottom="30.0" left="80.0" right="80.0" top="30.0" />
            </padding>

            <Text text="Login" textAlignment="CENTER" />

            <TextField fx:id="usernameField" prefWidth="100.0" promptText="username" />

            <HBox>
            <PasswordField fx:id="passwordField" prefWidth="250" promptText="password" />
            <TextField fx:id="passwordVisibleField" promptText="password" prefWidth="250" />

            </HBox>
            <CheckBox fx:id="showPasswordCheckBox" onAction="#togglePasswordVisible" text="Mostra password" />
                <HBox alignment="CENTER" spacing="30.0">

                    <Button onAction="#controllo" style=" -fx-text-fill: green;" text="conferma" />

                    <Button onAction="#exit" style="-fx-text-fill: red;" text="esci" />
                </HBox>

        </VBox>
    </center>

</BorderPane>
