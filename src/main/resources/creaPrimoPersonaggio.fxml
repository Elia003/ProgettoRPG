<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="it.unicam.cs.mpgc.rpg123022.Controller.CreazionePersonaggioController"
            prefHeight="620.0" prefWidth="960.0" style="-fx-background-color: linear-gradient(to bottom, #f7f1e3, #e8dcc8);">

    <center>
        <VBox alignment="CENTER" spacing="24.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>

            <children>
                <Label fx:id="titoloLabel"
                       text="Crea il tuo primo personaggio"
                       style="-fx-text-fill: rgba(115, 32, 3, 1);"/>

                <GridPane alignment="CENTER" hgap="18.0" vgap="18.0" maxWidth="520.0">
                    <children>
                        <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="nomeField"
                                   promptText="Inserisci il nome"
                                   prefWidth="260.0"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>

                        <Label text="Classe:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <ChoiceBox fx:id="classeChoiceBox"
                                   prefWidth="260.0"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                        <Label text="Genere:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <ChoiceBox fx:id="genereChoiceBox"
                                   prefWidth="260.0"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2"/>
                    </children>
                </GridPane>

                <HBox alignment="CENTER" spacing="18.0">
                    <children>
                        <Button text="Crea"
                                onAction="#createPersonaggio"
                                prefWidth="140.0"
                                prefHeight="42.0"
                                style="-fx-background-color: #8d3b2f; -fx-text-fill: white;"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

</BorderPane>
