<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0" prefWidth="960.0"
            style="-fx-background-color: linear-gradient(to bottom, #f7f1e3, #e8dcc8);"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unicam.cs.mpgc.rpg123022.Controller.DatabaseViewController">
    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Database Viewer" />
            <HBox spacing="10.0">
                <ComboBox fx:id="vistaComboBox" onAction="#aggiornaVista" prefWidth="180.0" />
                <TextField fx:id="ricercaField" onAction="#aggiornaVista" prefWidth="260.0" promptText="Cerca per nome" />
                <Button mnemonicParsing="false" onAction="#aggiornaVista" text="Cerca" />
                <Button mnemonicParsing="false" onAction="#pulisciRicerca" text="Pulisci" />
                <Button mnemonicParsing="false" onAction="#exit" text="Indietro" />
            </HBox>
            <Label fx:id="statoLabel" text="Risultati trovati: 0" />
        </VBox>
    </top>
    <center>
        <TableView fx:id="risultatiTableView" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="categoriaColumn" prefWidth="120.0" text="Categoria" />
                <TableColumn fx:id="idColumn" prefWidth="80.0" text="Id" />
                <TableColumn fx:id="nomeColumn" prefWidth="180.0" text="Nome" />
                <TableColumn fx:id="dettaglioColumn" prefWidth="560.0" text="Dettagli" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" top="0.0" />
            </BorderPane.margin>
        </TableView>
    </center>
</BorderPane>
